# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env

# Ваш ключ Gemini (обязательно для генерации)
GEMINI_API_KEY=

# Настройки GitHub (опционально для синхронизации)
GITHUB_REPO=
GITHUB_TOKEN=

# Модели (через запятую)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
