# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env

# Ваш ключ Gemini (обязательно для генерации)
GEMINI_API_KEY=

# Настройки GitHub (опционально для синхронизации)
GITHUB_REPO=
GITHUB_TOKEN=

# Модели (через запятую)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# --- Remote BFF (тонкий клиент) ---
REMOTE_MODE=false
REMOTE_SERVER_URL=
# Для standalone в LAN: разрешить private-адрес сервера при pairing.
REMOTE_ALLOW_PRIVATE_URLS=false
# REMOTE_DEVICE_TOKEN=  # только для отладки; в аддоне используется pairing
# MEDIA_DIR=  # по умолчанию $DATA_DIR/media

# Semantic enricher (admin Gemini key; free Lite models)
SEMANTIC_ENRICHER_ENABLED=true
SEMANTIC_ENRICHER_IDLE_SECONDS=600
SEMANTIC_ENRICHER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Бэкапы ---
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30

# --- CORS (обычно пусто: UI и BFF same-origin) ---
CORS_ORIGINS=
# Разрешать URL на приватные адреса (только локальная разработка)
ALLOW_PRIVATE_URLS=false

# --- YouTube / Apify ---
# Токен Apify (https://console.apify.com/account/integrations)
APIFY_TOKEN=
APIFY_ACTOR_ID=automationnation/youtube-transcript-scraper
# Запасной лимит, если Apify не вернул maxMonthlyUsageUsd
APIFY_QUOTA_LIMIT_USD=5
# Блокировка импорта при достижении этой доли лимита (0.9 = 90%)
APIFY_STOP_RATIO=0.9
# Глобальный выключатель YouTube-импорта (false — вкладка скрыта, API отдаёт 503)
FEATURE_YOUTUBE_IMPORT=true

# --- ВкусВилл OAuth 2.0 + PKCE ---
# Глобальные креды OAuth-приложения (не пользовательские токены).
VKUSVILL_CLIENT_ID=
VKUSVILL_CLIENT_SECRET=
VKUSVILL_REDIRECT_URI=https://recipe.example.com/api/stores/vkusvill/callback
VKUSVILL_SCOPES=catalog.search purchase_history.read discounts.view offline_access
VKUSVILL_AUTH_URL=https://oauth.vkusvill.ru/oauth2/auth
VKUSVILL_TOKEN_URL=https://oauth.vkusvill.ru/oauth2/token
VKUSVILL_REVOKE_URL=https://oauth.vkusvill.ru/oauth2/revoke
VKUSVILL_MCP_URL=https://mcp.vkusvill.ru/mcp
VKUSVILL_MCP_TIMEOUT=30
VKUSVILL_MAX_CART_ITEMS=100
VKUSVILL_LLM_TIMEOUT=120
# VKUSVILL_PROXY=http://proxy.example:8080

# --- Фоновая нормализация рецептов ---
RECIPE_NORMALIZER_ENABLED=false
RECIPE_ENRICHER_ENABLED=false
RECIPE_NORMALIZER_START_DELAY=60
RECIPE_NORMALIZER_INTERVAL=300
