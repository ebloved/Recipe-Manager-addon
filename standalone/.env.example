# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env

# --- Google OAuth (Для Standalone) ---
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8099/api/auth/callback
SECRET_KEY=generate_a_random_long_string_here

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# --- GitHub sync (Опционально) ---
GITHUB_REPO=
GITHUB_TOKEN=

# --- Настройки ---
GENERATOR_AUTO_ACTIVE_TIME=false

# Локальные эмбеддинги (для Standalone)
STANDALONE_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SERVICE_TOKEN=secret-token-for-addon

# OrcaRouter — порядок моделей при 429. Comma-separated.
# По умолчанию: tencent/hy4-preview-free (250 RPD) → deepseek-* (50 RPD) → orcaverify (50 RPD)
# ORC_MODELS=tencent/hy4-preview-free,deepseek/deepseek-v4.1-flash-free
